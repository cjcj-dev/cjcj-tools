[package]
name = "cjfmt_core"
version = "0.1.0"
cjc-version = "1.1.0"
output-type = "static"
src-dir = "@SOURCE@"
compile-option = ""
link-option = ""

[dependencies]
"cjcj::parse" = { path = "@FRONTEND@/packages/parse" }
"cjcj::ast" = { path = "@FRONTEND@/packages/ast" }
"cjcj::basic" = { path = "@FRONTEND@/packages/basic" }
