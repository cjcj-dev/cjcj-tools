    out["ADD_IMPORT_STATEMENT"] = Rule(false, true, "Added import statement or changed modifier of an existing one.")
    out["DEL_IMPORT_STATEMENT"] = Rule(true, true, "Deleted import statement or changed modifier of an existing one.")
    out["DEL_NONPUBLIC_IMPORT_STATEMENT"] = Rule(false, true, "Deleted non public import statement.")
    out["DEL_TYPE_ALIAS"] = Rule(true, true, "Public type alias deleted.")
    out["MOD_TYPE_ALIAS"] = Rule(true, true, "Public type alias modified.")
    out["VAR_NON_ACCESS_MODIFIER_MODIFIED"] = Rule(true, true, "Modified variable non-access modifier visible outside the module.")
    out["VAR_NON_ACCESS_MODIFIER_MODIFIED_LET_CONST"] = Rule(false, true, "Modified variables' non-access modifier from let to const for class visible outside the module.")
    out["VAR_ACCESS_MODIFIER_MODIFIED"] = Rule(true, true, "Variable declaration visible outside the module made protected or internal.")
    out["FUNC_ACCESS_MODIFIER_MODIFIED"] = Rule(true, true, "Function declaration visible outside the module made protected or internal.")
    out["FUNC_NON_ACCESS_MODIFIER_UNSAFE_ADDED"] = Rule(true, true, "Function declaration visible outside the module made unsafe.")
    out["FUNC_NON_ACCESS_MODIFIER_CONST_REMOVED"] = Rule(true, true, "Const modifier removed for function declaration visible outside the module.")
    out["STRUCT_ACCESS_MODIFIER_MODIFIED"] = Rule(true, true, "Struct declaration visible outside the module made protected or internal.")
    out["ENUM_ACCESS_MODIFIER_MODIFIED"] = Rule(true, true, "Enum declaration visible outside the module made protected or internal.")
    out["CLASS_ACCESS_MODIFIER_MODIFIED"] = Rule(true, true, "Class declaration visible outside the module made protected or internal.")
    out["CLASS_NON_ACCESS_MODIFIER_ABSTRACT_ADDED"] = Rule(true, true, "Class declaration visible outside the module added abstract.")
    out["CLASS_NON_ACCESS_MODIFIER_ABSTRACT_DELETED"] = Rule(true, true, "Class declaration visible outside the module deleted abstract.")
    out["CLASS_MODIFIER_PUBLIC_DELETED"] = Rule(true, true, "Class declaration visible outside the module deleted public.")
    out["CLASS_MODIFIER_SEALED_DELETED"] = Rule(true, true, "Class declaration visible outside the module deleted sealed.")
    out["CLASS_NON_ACCESS_MODIFIER_SEALED_ADDED"] = Rule(true, true, "Class declaration visible outside the module made sealed.")
    out["CLASS_NON_ACCESS_MODIFIER_OPEN_REMOVED"] = Rule(true, true, "Open modifier removed for class declaration visible outside the module.")
    out["INTERFACE_ACCESS_MODIFIER_MODIFIED"] = Rule(true, true, "Interface declaration visible outside the module made protected or internal.")
    out["INTERFACE_MODIFIER_SEALED_ADDED"] = Rule(true, true, "Interface declaration visible outside the module added modifier 'sealed'.")
    out["INTERFACE_MODIFIER_SEALED_DELETED"] = Rule(true, true, "Interface declaration deleted modifier 'sealed' when interface without modifier 'public'.")
    out["INTERFACE_MODIFIER_PUBLIC_DELETED"] = Rule(true, true, "Interface declaration visible outside the module deleted or changed modifier 'public'.")
    out["PACKAGE_DECL_CHANGED"] = Rule(true, true, "Package name or package access level changed.")
    out["STRUCT_STATIC_VAR_DEL"] = Rule(true, true, "Deleted static variable member from the struct.")
    out["STRUCT_INSTANCE_VAR_DEL"] = Rule(true, true, "Deleted instance public variable member from the struct.")
    out["STRUCT_INSTANCE_VAR_ACCESS_MODIFIED"] = Rule(true, true, "Modified instance public variable member modifier to not visible outside the struct.")
    out["STRUCT_INST_NO_PUBLIC_VAR_DEL"] = Rule(false, true, "Deleted instance non public variable member from the struct.")
    out["STRUCT_STATIC_VAR_PUBLIC_DEL"] = Rule(true, true, "Changed static variable member's modifier of struct visible outside the module. public deleted.")
    out["STRUCT_STATIC_VAR_INIT_MODIFIED"] = Rule(false, true, "Change the initial value of the const variable.")
    out["STRUCT_STATIC_VAR_TYPE_MODIFIED"] = Rule(true, true, "Modified static variables' type for struct visible outside the module. The new type is not a subtype of the old type.")
    out["STRUCT_STATIC_VAR_TYPE_MODIFIED_CLASS_LIKE"] = Rule(false, true, "Modified static variables' type for struct visible outside the module. The two types are compatible only when both are classes or interfaces types.")
    out["CLASS_STATIC_MEMBER_FUNC_ADDED"] = Rule(false, true, "Added overriding static member function of class.")
    out["CLASS_STATIC_MEMBER_PROP_ADDED"] = Rule(false, true, "Added overriding static member property of class.")
    out["CLASS_INSTANCE_MEMBER_FUNC_ADDED"] = Rule(true, false, "Added instance member function without default implementation of class.")
    out["CLASS_INSTANCE_MEMBER_PROP_ADDED"] = Rule(true, false, "Added instance member property without default implementation of class.")
    out["CLASS_INSTANCE_MEMBER_FUNC_ADDED2"] = Rule(false, true, "Added overriding instance member function of class.")
    out["CLASS_INSTANCE_MEMBER_PROP_ADDED2"] = Rule(false, true, "Added overriding instance member property of class.")
    out["CLASS_OPEN_INSTANCE_MEMBER_FUNCS_ADDED"] = Rule(false, true, "Added open instance member functions for classes.")
    out["CLASS_OPEN_INSTANCE_MEMBER_PROPS_ADDED"] = Rule(false, true, "Added open instance member properties for classes.")
    out["CLASS_OPEN_INSTANCE_MEMBER_FUNCS_ORDER_CHANGED"] = Rule(false, true, "Changed order of open instance member functions for classes.")
    out["CLASS_OPEN_INSTANCE_MEMBER_PROPS_ORDER_CHANGED"] = Rule(false, true, "Changed order of open instance member properties for classes.")
    out["CLASS_INSTANCE_MEMBER_FUNCS_DELETED"] = Rule(true, true, "Class member function visible outside the module deleted or made private.")
    out["CLASS_INSTANCE_MEMBER_PROPS_DELETED"] = Rule(true, true, "Class member property visible outside the module deleted or made private.")
    out["PRIMARY_CONSTRUCTOR_ADDED"] = Rule(false, true, "Added primary constructor with member variable parameter.")
    out["PRIMARY_CONSTRUCTOR_NON_PUBLIC_DELETED"] = Rule(true, true, "Deleted non public primary constructor with member variable parameter.")
    out["PRIMARY_CONSTRUCTOR_NON_PUBLIC_DELETED2"] = Rule(false, true, "Deleted non public primary constructor with private member variable parameter.")
    out["CLASS_CONSTRUCTOR_DELETED"] = Rule(true, true, "Class constructor visible outside the module deleted or made private.")
    out["CLASS_INSTANCE_MEMBER_FUNC_FROZEN_ANNO_DELETED"] = Rule(false, true, "Deleted frozen annotation of instance member functions for classes.")
    out["CLASS_INSTANCE_MEMBER_PROP_FROZEN_ANNO_DELETED"] = Rule(false, true, "Deleted frozen annotation of instance member properties for classes.")
    out["CLASS_CONSTRUCTOR_FROZEN_ANNO_DELETED"] = Rule(false, true, "Deleted frozen annotation of constructors for classes.")
    out["CLASS_INSTANCE_MEMBER_FUNC_VISIBILITY_CHANGED"] = Rule(true, true, "Changed visibility of instance member functions for classes.")
    out["CLASS_INSTANCE_MEMBER_PROP_VISIBILITY_CHANGED"] = Rule(true, true, "Changed visibility of instance member properties for classes.")
    out["CLASS_CONSTRUCTOR_VISIBILITY_CHANGED"] = Rule(true, true, "Changed visibility of constructors for classes.")
    out["CLASS_INSTANCE_MEMBER_FUNC_UNSAFE_ATTR_ADDED"] = Rule(true, true, "Added unsafe attribute of instance member functions for classes.")
    out["CLASS_INSTANCE_MEMBER_FUNC_CONST_ATTR_ADDED"] = Rule(false, true, "Added const attribute of instance member functions for classes.")
    out["CLASS_INSTANCE_MEMBER_FUNC_CONST_ATTR_DELETED"] = Rule(true, true, "Deleted const attribute of instance member functions for classes.")
    out["CLASS_CONSTRUCTOR_CONST_ATTR_DELETED"] = Rule(true, true, "Deleted const attribute of constructors for classes.")
    out["CLASS_INSTANCE_MEMBER_FUNC_STATIC_ATTR_DELETED"] = Rule(true, true, "Deleted static attribute of instance member functions for classes.")
    out["CLASS_INSTANCE_MEMBER_FUNC_STATIC_ATTR_ADDED"] = Rule(true, true, "Added static attribute of instance member functions for classes.")
    out["CLASS_INSTANCE_MEMBER_FUNC_OPEN_ATTR_DELETED"] = Rule(true, true, "Deleted open attribute of instance member functions for classes.")
    out["CLASS_INSTANCE_MEMBER_FUNC_OPEN_ATTR_ADDED"] = Rule(false, true, "Added open attribute of instance member functions for classes.")
    out["CLASS_INSTANCE_MEMBER_PROP_STATIC_ATTR_ADDED"] = Rule(true, true, "Added static attribute of instance member properties for classes.")
    out["CLASS_INSTANCE_MEMBER_PROP_STATIC_ATTR_DELETED"] = Rule(true, true, "Deleted static attribute of instance member properties for classes.")
    out["CLASS_MEMBER_PROP_MUT_ATTR_DELETED"] = Rule(true, true, "Deleted mut attribute of member properties for classes.")
    out["CLASS_INSTANCE_MEMBER_FUNC_DEPRE_ANNO_ADDED"] = Rule(true, true, "Added deprecated annotation of instance member functions for classes.")
    out["CLASS_INSTANCE_MEMBER_FUNC_DEPRE_ANNO_CHANGED"] = Rule(true, true, "Changed deprecated annotation of instance member functions for classes.")
    out["CLASS_INSTANCE_MEMBER_PROP_DEPRE_ANNO_ADDED"] = Rule(true, true, "Added deprecated annotation of instance member properties for classes.")
    out["CLASS_INSTANCE_MEMBER_PROP_DEPRE_ANNO_CHANGED"] = Rule(true, true, "Changed deprecated annotation of instance member properties for classes.")
    out["CLASS_CONSTRUCTOR_DEPRE_ANNO_ADDED"] = Rule(true, true, "Added deprecated annotation of constructors for classes.")
    out["CLASS_CONSTRUCTOR_DEPRE_ANNO_CHANGED"] = Rule(true, true, "Changed deprecated annotation of constructors for classes.")
    out["STRUCT_MEMBER_VAR_NON_ACCESS_MODIFIER_MODIFIED"] = Rule(true, true, "Modified member variables' non-access modifier for struct visible outside the module.")
    out["STRUCT_MEMBER_VAR_NAME_MODIFIED"] = Rule(true, true, "Modified public member variables' name for struct visible outside the module.")
    out["STRUCT_MEMBER_VAR_TYPE_MODIFIED"] = Rule(true, true, "Modified member variables' type for struct visible outside the module.")
    out["STRUCT_NONPUBLIC_MEMBER_VAR_TYPE_MODIFIED"] = Rule(false, true, "Modified nonpublic member variables' type for struct visible outside the module.")
    out["STRUCT_MEMBER_VAR_ORDER_MODIFIED"] = Rule(false, true, "Modified member variables' order for struct visible outside the module.")
    out["STRUCT_MEMBER_VAR_ADDED_ABI"] = Rule(false, true, "Added member variable to a struct.")
    out["STRUCT_CLASS_MEMBER_VAR_INIT_MODIFIED"] = Rule(false, true, "Change the initial value of member variable when struct/class has the const variable or @Frozen init func.")
    out["CLASS_MEMBER_VAR_DELETED_ABI"] = Rule(false, true, "Deleted private/internal member variable of a class.")
    out["CLASS_STATIC_MEMBER_VAR_DELETED"] = Rule(true, true, "Class public static member variable visible outside the module deleted or made private.")
    out["CLASS_PUBLIC_MEMBER_VAR_DELETED"] = Rule(true, true, "Deleted class public/protected member variable.")
    out["CLASS_MEMBER_VAR_ADDED_ABI"] = Rule(false, true, "Added member variable to a class.")
    out["CLASS_STATIC_CONST_VAR_INIT_MODIFIED"] = Rule(false, true, "Modified static constant variables' initial value for class visible outside the module.")
    out["CLASS_STATIC_VAR_TYPE_MODIFIED"] = Rule(true, true, "Modified static variables' type for class visible outside the module. The new type is not a subtype of the old type.")
    out["CLASS_STATIC_VAR_TYPE_MODIFIED_CLASS_LIKE"] = Rule(false, true, "Modified static variables' type for class visible outside the module. The two types are compatible only when both are classes or interfaces types.")
    out["CLASS_STATIC_VAR_ACCESS_MODIFIER_MODIFIED"] = Rule(true, true, "Class static member variable visible outside the module made protected or internal.")
    out["CLASS_STATIC_VAR_NON_ACCESS_MODIFIER_MODIFIED"] = Rule(true, true, "Modified static member variables' non-access modifier for class visible outside the module.")
    out["CLASS_STATIC_VAR_DELETED_STATIC"] = Rule(true, true, "Modified static member variables deleted static.")
    out["CLASS_STATIC_VAR_NON_ACCESS_MODIFIER_MODIFIED_LET_CONST"] = Rule(false, true, "Modified member variables' non-access modifier from let to const for class visible outside the module.")
    out["CLASS_MEMBER_VAR_NON_ACCESS_MODIFIER_MODIFIED"] = Rule(true, true, "Modified member variables' non-access modifier for class visible outside the module.")
    out["CLASS_MEMBER_VAR_NAME_MODIFIED"] = Rule(true, true, "Modified public member variables' name for class visible outside the module.")
    out["CLASS_PUBLIC_PROTECTED_MEMBER_VAR_TYPE_MODIFIED"] = Rule(true, true, "Modified member variables' type for class visible outside the module.")
    out["CLASS_PRIVATE_INTERNAL_MEMBER_VAR_TYPE_MODIFIED"] = Rule(false, true, "Modified private/internal member variables' type for class visible outside the module.")
    out["CLASS_MEMBER_VAR_ORDER_MODIFIED"] = Rule(false, true, "Modified member variables' order for class visible outside the module.")
    out["CLASS_MEMBER_VAR_ACCESS_MODIFIER_MODIFIED"] = Rule(true, true, "Class member variable declaration visible outside the module made internal, or private.")
    out["CLASS_MEMBER_VAR_DEPRE_ANNO_MOD"] = Rule(true, true, "Modified class member variables deprecated annotation with compilation error.")
    out["CLASS_MEMBER_VAR_DEPRE_ANNO_ADD"] = Rule(true, true, "Added deprecated annotation to class member variable with compilation error.")
    out["ENUM_CONSTRUCTOR_DELETED"] = Rule(true, true, "Deleted enum constructor.")
    out["ENUM_MEMBER_VAR_ORDER_MODIFIED"] = Rule(false, true, "Modified order of constructor for enum visible outside the module.")
    out["ENUM_CONSTRUCTOR_ADDED_EXHAUSTIVE"] = Rule(true, true, "Added constructor to exhaustive enum.")
    out["ENUM_CONSTRUCTOR_ADDED_NON_EXHAUSTIVE"] = Rule(false, true, "Added constructor to non-exhaustive enum, and either the constructor is not at the end or the memory layout has changed.")
    out["CLASS_INSTANCE_MEMBER_PROP_RETURN_TYPE_CHANGED"] = Rule(true, true, "Changed member property's return type of class visible outside the module.")
    return out
}
