package cjcompat

import std.collection.*

class Rule {
    let api: Bool
    let abi: Bool
    let description: String
    init(api: Bool, abi: Bool, description: String) { this.api = api; this.abi = abi; this.description = description }
}

func RuleCatalog(): HashMap<String, Rule> {
    let out = HashMap<String, Rule>()
    out["VAR_DELETED"] = Rule(true, true, "Variable declaration visible outside the module deleted or made private.")
    out["VAR_LOCATION_CHANGED"] = Rule(false, true, "Changed location of private variable declaration visible outside the module.")
    out["FUNC_DELETED"] = Rule(true, true, "Function declaration visible outside the module deleted or made private.")
    out["FUNC_LOCATION_CHANGED"] = Rule(false, true, "Changed location of private function declaration visible outside the module.")
    out["STRUCT_VAR_MODIFIER_STATIC_DELETED"] = Rule(true, true, "Deleted the modifier 'static' of the member var of the struct.")
    out["STRUCT_DELETED"] = Rule(true, true, "Struct declaration visible outside the module deleted or made private.")
    out["STRUCT_LOCATION_CHANGED"] = Rule(false, true, "Changed location of private struct declaration visible outside the module.")
    out["ENUM_DELETED"] = Rule(true, true, "Enum declaration visible outside the module deleted or made private.")
    out["ENUM_LOCATION_CHANGED"] = Rule(false, true, "Changed location of private enum declaration visible outside the module.")
    out["CLASS_DELETED"] = Rule(true, true, "Class declaration visible outside the module deleted or made private.")
    out["CLASS_LOCATION_CHANGED"] = Rule(false, true, "Changed location of private class declaration visible outside the module.")
    out["INTERFACE_DELETED"] = Rule(true, true, "Interface declaration visible outside the module deleted or made private.")
    out["INTERFACE_LOCATION_CHANGED"] = Rule(false, true, "Changed location of private interface declaration visible outside the module.")
    out["EXTEND_DELETED"] = Rule(true, true, "Extend declaration visible outside the module deleted or made private.")
    out["FUNC_NUM_PARAMS"] = Rule(true, true, "Changed number of parameters of function visible outside the module.")
