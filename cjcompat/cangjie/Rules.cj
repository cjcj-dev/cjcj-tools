    out["FUNC_RETURN_TYPE_SUBTYPE"] = Rule(true, true, "Changed return type of function visible outside the module. The new return type is not a subtype of the old return type.")
    out["FUNC_RETURN_TYPE_CLASS_LIKE"] = Rule(false, true, "Changed return type of function visible outside the module. The two types are compatible only when both are classes or interfaces types.")
    out["FUNC_RETURN_TYPE_OPEN"] = Rule(true, true, "Changed return type of open function visible outside the module.")
    out["CONST_OR_FROZEN_BODY_CHANGE"] = Rule(false, true, "The body of a const function or function marked with @Frozen changed.")
    out["FUNC_CHANGE_NAME_OF_NAMED_PARAMETER"] = Rule(true, true, "Cannot change name of named parameter.")
