[package]
name = "cangjie_lsp_core"
version = "0.1.0"
cjc-version = "1.1.0"
output-type = "static"
src-dir = "src"
[dependencies]
cangjie_lsp_protocol = { path = "protocol" }
"cjcj::parse" = { path = "@FRONTEND@/packages/parse" }
"cjcj::ast" = { path = "@FRONTEND@/packages/ast" }
"cjcj::basic" = { path = "@FRONTEND@/packages/basic" }
"cjcj::frontend" = { path = "@FRONTEND@/packages/frontend" }
