        case "G_ERR_04_avoid_return_finally" => "MANDATORY"
        case "G_ERR_04_avoid_break_finally" => "MANDATORY"
        case "G_ERR_04_avoid_continue_finally" => "MANDATORY"
        case "G_ERR_04_avoid_throw_finally" => "MANDATORY"
        case "G_CHK_04_untrusted_regular_expressions_redundantGroup" => "MANDATORY"
        case "G_CHK_04_untrusted_regular_expressions_itselfRepeated" => "MANDATORY"
        case "G_CHK_04_untrusted_regular_expressions_subexpressionsOverlap" => "MANDATORY"
        case "G_CHK_04_untrusted_regular_expressions_external_data" => "MANDATORY"
        case "G_CON_02_lock" => "MANDATORY"
        case "G_FUN_02_unused_param_information" => "MANDATORY"
        case "P_02_diff_mutex" => "MANDATORY"
