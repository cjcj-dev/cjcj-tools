        case "G_OTH_03_public_ip_hardcode_information" => "MANDATORY"
        case "G_OTH_03_public_url_hardcode_information" => "MANDATORY"
        case "G_SEC_01_open_check_function_information" => "MANDATORY"
        case "G_SER_01_serialize_sensitive_field" => "MANDATORY"
        case "G_SER_01_serialize_sensitive_data" => "MANDATORY"
        case "G_SER_02_Deserialization_Bypass" => "MANDATORY"
        case "G_SER_03_key_lack" => "MANDATORY"
        case "G_SER_03_return_error" => "MANDATORY"
        case "G_SER_03_type_error" => "MANDATORY"
        case "G_SER_03_type_lack" => "MANDATORY"
        case "P_01_dead_lock" => "MANDATORY"
        case "G_ERR_02_sensitive_exception" => "MANDATORY"
