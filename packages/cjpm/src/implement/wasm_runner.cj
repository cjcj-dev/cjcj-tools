package cjpm.implement

import std.collection.*
import std.env.getVariable
import std.fs.*
import cjpm.config.*

// Node.js node:wasi host used by `cjpm run` / `cjpm test` for wasm32-wasi command modules (M0).
// The runner script ships inside cjpm and is (re)written next to the artifacts, so the host
// protocol always matches this cjpm. Exit status: the module's WASI proc_exit code, 0 when _start
// returns, 134 on a wasm trap (like an abort), 125 when the module cannot be read/compiled/linked.
public let WASI_RUNNER_FILE_NAME: String = "cjpm-wasi-runner.mjs"
public let WASI_RUNNER_TRAP_EXIT: Int64 = 134
public let WASI_RUNNER_HOST_EXIT: Int64 = 125

let WASI_RUNNER_SOURCE: String = """
// Generated by cjpm: wasm32-wasi (WASI preview1) runner on Node.js node:wasi.
// usage: node cjpm-wasi-runner.mjs <module.wasm> [args...]
import { readFile } from 'node:fs/promises';
import { WASI } from 'node:wasi';
import { argv, env, exit, cwd } from 'node:process';
import { basename } from 'node:path';
const file = argv[2];
if (!file) { console.error('cjpm-wasi-runner: missing module path'); exit(125); }
let bytes;
try { bytes = await readFile(file); } catch (e) { console.error('cjpm-wasi-runner: cannot read ' + file + ': ' + e.message); exit(125); }
if (bytes.length < 8 || bytes.readUInt32LE(0) !== 0x6d736100) { console.error('cjpm-wasi-runner: not a wasm module: ' + file); exit(125); }
const wasi = new WASI({ version: 'preview1', args: [basename(file), ...argv.slice(3)], env, preopens: { '.': cwd() }, returnOnExit: true });
let rc;
try {
  const mod = await WebAssembly.compile(bytes);
  const inst = await WebAssembly.instantiate(mod, wasi.getImportObject());
  rc = wasi.start(inst);
} catch (e) {
  if (e instanceof WebAssembly.RuntimeError) { console.error('cjpm-wasi-runner: wasm trap: ' + e.message); exit(134); }
  if (e instanceof WebAssembly.CompileError || e instanceof WebAssembly.LinkError) { console.error('cjpm-wasi-runner: ' + e.name + ': ' + e.message); exit(125); }
  throw e;
}
exit(rc ?? 0);
"""

public class WasmRunner {
    public WasmRunner(public let node: String, public let script: String) {}

    // (command, arguments) that run `module` with `moduleArgs` under node:wasi.
    public func command(module: String, moduleArgs: Collection<String>): (String, Array<String>) {
        let args = ArrayList<String>(["--no-warnings", script, module])
        args.add(all: moduleArgs)
        (node, args.toArray())
    }
}

func findNodeOnPath(): ?String {
    let pathEnv = getVariable("PATH") ?? return None
    for (dir in pathEnv.split(":", removeEmpty: true)) {
        let candidate = Path(dir).join("node").toString()
        if (fileExists(candidate)) {
            return Some(candidate)
        }
    }
    return None
}

// SDK root: CANGJIE_HOME, else the directory above the cjc in use (as config/history.cj does).
public func resolveCangjieHome(): ?String {
    if (let Some(home) <- getVariable("CANGJIE_HOME")) {
        if (!home.isEmpty()) {
            return Some(home)
        }
    }
    let cjcBinDir = Path(state.cjcPath).parent
    if (cjcBinDir.isEmpty()) {
        return None
    }
    return FileInfo(cjcBinDir).parentDirectory?.path.toString()
}

// node: $CJPM_WASM_NODE, else the SDK's <CANGJIE_HOME>/tools/bin/node, else `node` on PATH.
public func resolveWasmNode(): ?String {
    if (let Some(node) <- getVariable("CJPM_WASM_NODE")) {
        if (!fileExists(node)) {
            eprintln("Error: CJPM_WASM_NODE='${node}' does not exist")
            return None
        }
        return Some(node)
    }
    if (let Some(home) <- resolveCangjieHome()) {
        let sdkNode = Path(home).join("tools").join("bin").join("node").toString()
        if (fileExists(sdkNode)) {
            return Some(sdkNode)
        }
    }
    return findNodeOnPath()
}

// Resolve node and write the runner script into `scratchDir`; prints an explicit error and returns
// None when no Node.js is available.
public func resolveWasmRunner(scratchDir: String): ?WasmRunner {
    let node = match (resolveWasmNode()) {
        case Some(n) => n
        case None =>
            eprintln("Error: running wasm32-wasi modules needs Node.js (node:wasi): set CJPM_WASM_NODE, " +
                "install the SDK node at CANGJIE_HOME/tools/bin/node, or put 'node' on PATH")
            return None
    }
    let script = Path(scratchDir).join(WASI_RUNNER_FILE_NAME)
    try {
        if (!directoryExists(scratchDir)) {
            Directory.create(Path(scratchDir), recursive: true)
        }
        File.writeTo(script, WASI_RUNNER_SOURCE.toArray())
    } catch (e: Exception) {
        eprintln("Error: cannot write the wasm runner ${script}: ${e.message}")
        return None
    }
    return Some(WasmRunner(node, script.toString()))
}

// SDK layout probe: <CANGJIE_HOME>/modules/wasi_wasm32_cjnative/std/<module>.cjo
public func wasmStdModulePath(module: String): ?String {
    let home = resolveCangjieHome() ?? return None
    Some(Path(home).join("modules").join("wasi_wasm32_cjnative").join("std").join("${module}.cjo").toString())
}
